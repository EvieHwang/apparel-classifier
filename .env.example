# Anthropic API key for the server-side LLM classification calls.
# Read from the environment, server-side only — never hard-coded, never committed.
ANTHROPIC_API_KEY=

# Filesystem path for the cumulative-tally SQLite database (feature 4). Optional:
# defaults to ./data/cumulative.sqlite for local dev. #6 points this at a mounted
# Fly volume so the cumulative number survives redeploys. The DB file is runtime
# state and is git-ignored — never committed.
CUMULATIVE_DB_PATH=
